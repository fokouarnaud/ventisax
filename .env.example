# Copier vers .env, privé et ignoré par Git. Générer une vraie clé sur le serveur.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=ventisax.pythonanywhere.com
DJANGO_SETTINGS_MODULE=config.production
# Activer seulement après configuration et essai du SMTP.
DJANGO_EMAIL_OTP=0
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
